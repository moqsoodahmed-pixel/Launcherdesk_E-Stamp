{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "**/apps/api/**",
      "**/packages/**",
      "**/package.json",
      "**/package-lock.json",
      "**/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start --workspace=apps/api",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}