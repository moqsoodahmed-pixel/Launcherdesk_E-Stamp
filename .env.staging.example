# ==============================================================================
# LauncherDesk E-Stamping - STAGING environment template (Phase 36)
#
# This is a STAGING-specific variant of the repo root `.env.example`. Variable
# names here are copied verbatim from `apps/api/src/config/env.js` (the single
# source of truth every variable is actually read from) - no variable has been
# invented. Every value below is empty or an explicit placeholder; this file
# must NEVER contain a real credential. Copy to `apps/api/.env` on the staging
# host (or supply via your platform's secret manager) and fill in real values
# there, never in source control.
#
# See docs/deployment/staging-deployment.md for what each variable requires.
# ==============================================================================

NODE_ENV=production
PORT=5000

# Must be the exact staging frontend origin - no wildcard, scheme + host only.
FRONTEND_URL=https://<STAGING_FRONTEND_DOMAIN>

# ---- Database (REQUIRED - fails closed in production if unset) ----
# Managed MongoDB cluster reachable from the API host's egress IP(s).
MONGODB_URI=<STAGING_MONGODB_CONNECTION_STRING>

# ---- JWT (REQUIRED - fails closed in production if unset) ----
# Generate fresh, high-entropy values for staging. Never reuse a value that
# has ever existed in a developer's local .env or in production.
JWT_SECRET=<GENERATE_FRESH_HIGH_ENTROPY_SECRET>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=<GENERATE_FRESH_HIGH_ENTROPY_SECRET>
JWT_REFRESH_EXPIRY=7d

# ---- OTP ----
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REVERIFY_INTERVAL_HOURS=24
# Must be UNSET in staging/production - DEV_FIXED_OTP_CODE is a
# development-only convenience and is never honored in production, but leave
# it unset here regardless, for clarity.
DEV_FIXED_OTP_CODE=

# ---- E-Stamp request modification window ----
REQUEST_MODIFY_WINDOW_MINUTES=20

# ---- Email (Brevo) - REQUIRED FOR PRODUCTION EMAIL, fails closed if unset ----
EMAIL_PROVIDER=brevo
BREVO_API_KEY=<STAGING_BREVO_API_KEY>
BREVO_SENDER_EMAIL=<VERIFIED_SENDER_EMAIL>
BREVO_SENDER_NAME=LauncherDesk E-Stamping
EMAIL_FROM=
EMAIL_FROM_NAME=

# ---- Razorpay (payments) - REQUIRED FOR PRODUCTION PAYMENTS, fails closed if unset ----
# Use Razorpay TEST MODE credentials for staging, never live-mode credentials.
RAZORPAY_KEY_ID=<STAGING_RAZORPAY_TEST_KEY_ID>
RAZORPAY_KEY_SECRET=<STAGING_RAZORPAY_TEST_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<STAGING_RAZORPAY_WEBHOOK_SECRET>

# ---- Cloudinary (file storage) - REQUIRED FOR PRODUCTION STORAGE, fails closed if unset ----
CLOUDINARY_CLOUD_NAME=<STAGING_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<STAGING_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<STAGING_CLOUDINARY_API_SECRET>

# ---- Upload limits ----
DOCUMENT_MAX_FILE_SIZE_MB=10

# ---- E-Stamp external provider ----
# BLOCKED: no real provider integration exists yet (see
# docs/deployment/staging-deployment.md section 19). Leaving this as "mock"
# means E-Stamp issuance will be REFUSED OUTRIGHT in production/staging with
# NODE_ENV=production - this is intentional fail-closed behavior, not a bug.
# Do not set this to anything other than "mock" until a real provider is
# implemented; setting it prematurely will not issue real certificates, it
# will only throw a clear "not implemented" error.
ESTAMP_PROVIDER=mock
ESTAMP_API_BASE_URL=
ESTAMP_API_KEY=
ESTAMP_API_SECRET=
ESTAMP_API_TIMEOUT_MS=15000
ESTAMP_PROVIDER_WEBHOOK_SECRET=
ESTAMP_PROVIDER_LOW_BALANCE_THRESHOLD=

# ---- Bulk E-Stamp request upload ----
BULK_ESTAMP_MAX_ROWS=500
BULK_ESTAMP_MAX_FILE_SIZE_MB=10

# ---- Seed script (apps/api/src/scripts/seed.js) ----
# Only used for the ONE-TIME, deliberate `npm run seed --workspace=apps/api`
# invocation against the staging database. Not auto-run on startup. Rotate
# this password immediately after first login (the seeded account already
# forces a password change).
SEED_MASTER_ADMIN_EMAIL=<STAGING_MASTER_ADMIN_EMAIL>
SEED_MASTER_ADMIN_PASSWORD=<GENERATE_FRESH_SEED_PASSWORD>
SEED_DEMO_ORG_NAME=Demo Client Pvt Ltd

# ==============================================================================
# Frontend (apps/web) - Vite env var, build-time only (baked into the static
# bundle at `npm run build --workspace=apps/web` time, not read at runtime).
# Copy this section to apps/web/.env.production (or set via your static host's
# build-time env config) before running the build for staging.
# ==============================================================================
VITE_API_BASE_URL=https://<STAGING_API_DOMAIN>/api/v1
