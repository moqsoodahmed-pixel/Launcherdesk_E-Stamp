{
  "name": "launcherdesk-estamping",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "start": "npm run start --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "seed:api": "npm run seed --workspace=apps/api"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
