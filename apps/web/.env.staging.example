# LauncherDesk E-Stamping (apps/web) - STAGING env template (Phase 36)
#
# Vite only exposes variables prefixed VITE_ to client code. This is the only
# such variable currently read (apps/web/src/api/client.js). It is baked into
# the built static bundle at `npm run build --workspace=apps/web` time - it is
# NOT read at runtime, so it must be set correctly BEFORE building, not after
# deploying the built assets.
#
# Copy to apps/web/.env.production (or supply via your static host/CI's
# build-time environment configuration) and fill in the real staging API
# origin. Never point this at localhost for a staging/production build.

VITE_API_BASE_URL=https://<STAGING_API_DOMAIN>/api/v1
