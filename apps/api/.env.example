# ==============================================================================
# LauncherDesk E-Stamping - Environment Configuration (.env)
# ==============================================================================
NODE_ENV="development"
PORT="5000"
FRONTEND_URL="http://localhost:5173"

# MongoDB Connection:
MONGODB_URI="mongodb://127.0.0.1:27017/launcherdesk_estamping"

# Security & Tokens:
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRY="7d"

# OTP Configuration:
DEV_FIXED_OTP_CODE=""
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_REVERIFY_INTERVAL_HOURS="24"
REQUEST_MODIFY_WINDOW_MINUTES="20"

# ==============================================================================
# EMAIL DELIVERY OPTIONS:
# Option 1: Brevo REST API
# Option 2: Brevo SMTP Relay (Bypasses Brevo REST IP Whitelist)
# Option 3: Gmail SMTP (Direct with App Password)
# ==============================================================================
# Brevo REST API:
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@launcherdesk.com"
BREVO_SENDER_NAME="LauncherDesk E-Stamping"

# Brevo SMTP Relay (Recommended if Brevo REST API gives Unauthorized / IP restriction):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="your-brevo-login-email@example.com"
# SMTP_PASS="your-brevo-smtp-key-or-api-key"

# Gmail SMTP (Recommended alternative for reliable delivery):
# GMAIL_USER="your-gmail-account@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"

# Razorpay:
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloudinary:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# E-Stamp Provider ("mock" or "provider"):
ESTAMP_PROVIDER="mock"
ESTAMP_FULFILMENT="manual"
